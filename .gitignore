# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.claude/
# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# export pipeline smoke test artifacts
/.export-smoke

# playwright
/test-results
/playwright-report
/playwright/.cache

# Proof output is generated, not authored. The scripts encode the checks and
# CI regenerates and uploads the pictures on every push; only the measurements
# (manifest.json, exports.json) are versioned, because those are worth diffing.
/.styling-proof
/docs/styling-proof/*.jpg
/docs/styling-proof/report.html
/docs/styling-proof/styling-proof.html

# responsive proof: screenshots are regenerated by `npm run proof:responsive`
# and uploaded by CI. The measurements in manifest.json are committed.
/docs/responsive-proof/*.jpg
/docs/responsive-proof/report.html
/docs/responsive-proof/device-proof.html
